{
  "name": "neweditor",
  "version": "0.1.0",
  "private": true,
  "description": "Учебный текстовый редактор TXT и Markdown",
  "author": "NewEditor contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.11.1 <25 || >=26.0.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.domain.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.renderer.json",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:native": "node scripts/test-native.mjs",
    "test:electron": "playwright test",
    "test:dev": "npm run build && node scripts/test-dev.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
